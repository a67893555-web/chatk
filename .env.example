# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PULSEWIRE_JWT_SECRET: HMAC-SHA256 secret used by Gateway Service for JWT & Presigned S3 URLs.
PULSEWIRE_JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# ==============================================================================
# SPLIT DEPLOYMENT: VERCEL (FRONTEND) + RENDER (BACKEND & REDIS)
# ==============================================================================

# Frontend (Vercel): Leave empty in local dev; set on Vercel to your Render Web Service URL
VITE_API_BASE_URL=""
VITE_WS_URL=""

# Backend (Render): Comma-separated allowed Vercel origins (supports https://*.vercel.app)
CORS_ALLOWED_ORIGINS=""

# Backend (Render): Injected automatically by render.yaml from pulsewire-redis Key Value store
REDIS_URL=""

# Backend (Render): Set to "false" when serving API/WebSocket only (without static SPA files)
SERVE_STATIC_SPA="true"
